{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "env": ["PROOFS_ENABLED"]
    },
    "test:proofs-enabled": {
      "dependsOn": ["^test:proofs-enabled"],
      "env": ["PROOFS_ENABLED"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
