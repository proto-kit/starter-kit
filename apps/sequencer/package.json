{
  "name": "@repo-apps/sequencer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "dotenvx run -f .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:proofs-enabled": "dotenvx run -f .env.test -f .env.proofs-enabled -- node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "script": "../../packages/utils/scripts/run-script.sh $@",
    "start": "bash -c 'env=$1; shift; pnpm run script \"$env\" start \"$env\" \"$@\"' --",
    "command": "../../packages/utils/scripts/run-command.sh $@",
    "docker-compose": "bash -c 'env=$1; shift; pnpm run command \"$env\" docker compose -f ./devops/docker-compose.yml \"$@\"' --",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.36.0",
    "@jest/globals": "^29.7.0",
    "@jest/types": "^29.6.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "jest": "^29.6.1",
    "reflect-metadata": "^0.1.13",
    "ts-jest": "^29.1.1"
  },
  "peerDependencies": {
    "@proto-kit/common": "../../../framework/packages/common",
    "@proto-kit/api": "../../../framework/packages/api",
    "@proto-kit/library": "../../../framework/packages/library",
    "@proto-kit/module": "../../../framework/packages/module",
    "@proto-kit/protocol": "../../../framework/packages/protocol",
    "@proto-kit/sdk": "../../../framework/packages/sdk",
    "@proto-kit/sequencer": "../../../framework/packages/sequencer",
    "@repo/runtime": "workspace:*",
    "@repo/utils": "workspace:*",
    "@repo/client": "workspace:*",
    "o1js": "../../../framework/node_modules/o1js",
    "specifier-resolution-node": "^1.1.4",
    "tsyringe": "../../../framework/node_modules/tsyringe",
    "loglevel": "^1.8.1",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@types/yargs": "^17.0.33",
    "yargs": "^17.7.2"
  }
}
